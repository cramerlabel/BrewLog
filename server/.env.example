# Port the Express API listens on
PORT=4000

# Path to the SQLite database file
DATABASE_PATH=./data/brewlog.db

# Secret used to sign session cookies - generate a long random value for production
SESSION_SECRET=change-me-in-production

# Directory where uploaded photos are stored (not web-served directly)
UPLOADS_DIR=./uploads

# Credentials used by the seed script to create the first admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-in-production
